# ==============================================================================
# CareerTrack AI — Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# JSON Web Token Secret Key
# Generate a strong 32+ character random string for production security
JWT_SECRET=careertrack-ai-production-super-secret-key-2026-replace-this-in-prod

# MongoDB Database Connection String (MongoDB Atlas / Local / Docker)
# When provided: CareerTrack AI connects to MongoDB and automatically provisions collections
# When omitted: Runs in local persistent JSON fallback mode (zero setup required!)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/careertrack?retryWrites=true&w=majority

# Public URL of the Application (optional, used for canonical URLs and absolute redirects)
NEXT_PUBLIC_APP_URL=https://careertrack-ai.vercel.app
